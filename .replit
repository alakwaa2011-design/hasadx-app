modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-server-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-server-typecheck"

[[workflows.workflow]]
name = "api-server-test"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server exec vitest run src/__tests__/"

[[workflows.workflow]]
name = "api-server-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server exec tsc --noEmit"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api-server-ai-vision-regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:ai-vision"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 90000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.production]
ALLOWED_ORIGINS = "https://hasadx.com,https://www.hasadx.com,https://hasaadx.com,https://www.hasaadx.com,https://mn-s-h-sd.replit.app"

[userenv.shared]
GOOGLE_CLIENT_ID = "281565681069-37f3c0p8lijijjmj3nie7a2hs3iilm7f.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID = "281565681069-37f3c0p8lijijjmj3nie7a2hs3iilm7f.apps.googleusercontent.com"
PUBLIC_APP_URL = "https://hasaadx.com"

[userenv.development]
API_PROXY_TARGET = "http://127.0.0.1:8080"

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 4200

[[ports]]
localPort = 8123
externalPort = 5173

[[ports]]
localPort = 18313
externalPort = 3002

[[ports]]
localPort = 18314
externalPort = 3003

[[ports]]
localPort = 22349
externalPort = 3001

[[ports]]
localPort = 22582
externalPort = 5000

[[ports]]
localPort = 24991
externalPort = 3000
